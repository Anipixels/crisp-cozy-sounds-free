; Crisp Cozy Sounds Free - demo project. Open this folder in Godot 4.3 or newer and press F5,
; or copy addons/crisp_cozy_free into your own project.
config_version=5

[application]

config/name="Crisp Cozy Sounds Free"
run/main_scene="res://addons/crisp_cozy_free/demo/cozy_sounds_demo.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://icon.png"

[autoload]

CrispCozySfx="*res://addons/crisp_cozy_free/crisp_cozy_sfx.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=600

[editor_plugins]

enabled=PackedStringArray("res://addons/crisp_cozy_free/plugin.cfg")
